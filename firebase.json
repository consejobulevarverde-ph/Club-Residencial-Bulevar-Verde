{
  "hosting": {
    "public": "public",
    "site": "bulevar-verde-app",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/vendor/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "singleProjectMode": false,
    "auth": { "host": "127.0.0.1", "port": 9109 },
    "storage": { "host": "127.0.0.1", "port": 9209 },
    "dataconnect": { "host": "127.0.0.1", "port": 9419 },
    "hub": { "host": "127.0.0.1", "port": 4810 },
    "logging": { "host": "127.0.0.1", "port": 4910 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4710 }
  }
}