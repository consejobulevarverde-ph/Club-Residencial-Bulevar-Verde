{
  "hosting": {
    "public": "public",
    "site": "bulevar-verde-app",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/vendor/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}